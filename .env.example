NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpmall
DB_USER=cpmall_user
DB_PASSWORD=replace_with_a_strong_password
DB_CONNECTION_LIMIT=10

# Add a payment provider only after selecting and configuring one.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email secrets belong here, never in source control.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@chachaprime.com
SMTP_PASSWORD=replace_with_rotated_password
